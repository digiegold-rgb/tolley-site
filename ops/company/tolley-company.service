[Unit]
Description=Tolley autonomous company worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jelly/tolley-company
EnvironmentFile=/home/jelly/.config/tolley-company/worker.env
ExecStart=/usr/bin/node --import ./ops/company/runtime.mjs --import tsx ops/company/worker.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
MemoryMax=1536M
CPUQuota=100%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/jelly/.config/tolley-company

[Install]
WantedBy=default.target
