[Unit]
Description=Tolley stock supplier email intake
After=network-online.target
[Service]
Type=oneshot
EnvironmentFile=%h/.config/tolley-stock/worker.env
WorkingDirectory=%h/tolley-stock
ExecStart=/usr/bin/flock -n %h/.local/state/tolley-stock/mail.lock /usr/bin/python3 %h/tolley-stock/ops/stock/mail-worker.py
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
